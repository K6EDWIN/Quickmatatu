DATABASE_URL=postgresql://user:password@your-neon-host/quickmatatu?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:8081

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@example.com
SMTP_APP_PASSWORD=replace-with-a-gmail-app-password
EMAIL_FROM=QuickMatatu <your-gmail-address@example.com>

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_NATIVE_REDIRECT_URI=quickmatatu:/oauthredirect
IOS_BUNDLE_IDENTIFIER=
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
